# ---- Required ----
DATABASE_URL=postgres://avail:avail@localhost:5432/avail24
# Long random string (>= 32 chars). Signs pharmacist links, sessions, admin cookies.
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Public base URL used inside WhatsApp messages
PUBLIC_BASE_URL=http://localhost:3000

# ---- Admin ----
# Generate with: npm run admin:hash -- "your-password"
ADMIN_PASSWORD_HASH=

# ---- Prescription / medicine photo reading (Claude vision) ----
ANTHROPIC_API_KEY=

# ---- Data import ----
GOOGLE_MAPS_API_KEY=

# ---- Optional: shared rate limiting across many servers ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
